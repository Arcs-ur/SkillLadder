include CITATION.cff
include LICENSE
include NOTICE
include requirements-paper.txt
include THIRD_PARTY_NOTICES.md
recursive-include audits *.py *.html *.css *.js
recursive-include configs *.json *.md *.yaml
recursive-include docs *.md
recursive-include integrations *.md *.patch
recursive-include prompts *.md
recursive-include scripts *.py
recursive-include tests *.py
prune output
prune outputs
prune results
prune logs
global-exclude *.py[cod]
global-exclude __pycache__
